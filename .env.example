# Copy to .env and fill in. Only the model API key is required.

# --- Required: the key for whichever model AGENT_MODEL points at ---
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...   # only needed if AGENT_MODEL is a Claude model

# --- Model selection (swappable, no code change) ---
# OpenAI default:
AGENT_MODEL=gpt-5-mini
ESCALATION_MODEL=gpt-5.5
# To use Claude instead, set:
#   AGENT_MODEL=anthropic/claude-sonnet-4-6
#   ANTHROPIC_API_KEY=sk-ant-...

# Below this confidence a bill is always routed to human review.
REVIEW_CONFIDENCE_THRESHOLD=0.75

# How the PDF is sent to the model:
#   native — hand the PDF directly (reads the text layer; best for digital invoices)
#   images — render pages to PNGs and send as vision (portable fallback, e.g. if a
#            provider/model rejects native file input)
PDF_INPUT_MODE=native

# Origins allowed to call the API (CORS). Includes the deployed UI origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://ap.loukik.dev
